# Copy this file to .env and adjust for your environment.
# Nothing in this file is a secret - EAACD currently has no credential-based
# configuration. If you add authentication later, keep secrets out of
# version control and inject them via your deployment platform instead.

# --- App / runtime ---
APP_ENV=development        # development | staging | production
DEBUG=false                # must be false in production
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Comma-separated list of allowed origins for the dashboard/API.
# "*" is ignored (treated as no origins allowed) when APP_ENV=production.
CORS_ALLOW_ORIGINS=http://localhost:8000

# --- Risk engine thresholds (defaults reproduce the original prototype) ---
RISK_SUSPICIOUS_THRESHOLD=3
RISK_ATTACKER_THRESHOLD=6
RISK_CRITICAL_ENDPOINT_WEIGHT=2
RISK_DESTRUCTIVE_METHOD_WEIGHT=1
RISK_HIGH_VOLUME_WEIGHT=1
RISK_HIGH_VOLUME_REQUEST_COUNT=10
RISK_ADMIN_WITHOUT_LOGIN_WEIGHT=2
CRITICAL_ENDPOINT_MIN_REQUESTS=3

# --- Adaptive friction ---
SUSPICIOUS_RESPONSE_DELAY_SECONDS=1.0

# --- Behavioral state bounds ---
MAX_TRACKED_USERS=10000
MAX_HISTORY_PER_USER=500
USER_IDLE_TTL_SECONDS=3600

# --- Request hardening ---
MAX_REQUEST_BODY_BYTES=1000000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
